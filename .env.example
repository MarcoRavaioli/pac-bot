# --- Trading212 ---------------------------------------------------------------
# Autenticazione Basic: servono ENTRAMBI id e chiave (l'header con la sola
# chiave risponde 401 — verificato sul conto demo l'8/9/2026).
T212_API_KEY=your_api_key_here
TRADING212_ID=your_id_here
# https://demo.trading212.com per il conto demo, https://live.trading212.com per i soldi veri
T212_API_URL=https://demo.trading212.com

# --- Strategia Fase 4 ---------------------------------------------------------
# ETF a leva da comprare, ticker Trading212.
# XS2Dl_EQ = Xtrackers S&P 500 2x Leveraged, linea LSE quotata in USD.
# Alternativa stessa ISIN (LU0411078552) quotata in EUR su Xetra: DBPGd_EQ,
# con YF_ASSET_TICKER=DBPG.DE — evita la commissione di cambio di T212.
T212_TICKER=XS2Dl_EQ
YF_ASSET_TICKER=XS2D.L

# Indice sottostante da cui esce il segnale (Yahoo Finance). ^GSPC = S&P 500,
# la stessa serie usata nel backtest.
YF_SIGNAL_TICKER=^GSPC
SMA_WINDOW=200

# Capitale allocato alla strategia, in euro. Il bot NON guarda il saldo del
# conto: usa questo budget e il contatore interno in data/fase4_state.json.
BUDGET_EUR=350

# Il bot si ferma se l'equity scende oltre questa frazione sotto il picco.
KILL_SWITCH_DRAWDOWN=0.30

# Oltre questa età dei dati di segnale il bot non opera e avvisa su Telegram.
MAX_SIGNAL_STALENESS_DAYS=5

# Ora italiana della valutazione giornaliera. 09:05 = poco dopo l'apertura di
# LSE/Xetra, sul segnale della chiusura USA precedente (coerente col backtest,
# che incassa il rendimento dal giorno successivo al segnale).
RUN_AT=09:05

# Ordine minimo e margine di sicurezza sul sizing (0.005 = 0.5%).
MIN_ORDER_EUR=5.0
SLIPPAGE_BUFFER=0.005

# --- Notifiche ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
